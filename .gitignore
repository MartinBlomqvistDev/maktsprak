# ----------------------------------------------------
# 1. VIRTUELLA MILJÖER & PYTHON ARTEFAKTER
# ----------------------------------------------------
.venv/
venv/
env/

# Python cache och kompilerade filer
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ----------------------------------------------------
# 2. DATA SCIENCE & MODELL-ARTEFAKTER (MÅSTE IGNORERAS)
# ----------------------------------------------------

data/raw/*
data/raw/**
*.pdf

# Databaser och mappar (KRITISK KORRIGERING)
# Hela mappen data/db/:
data/db/
data/db/maktsprakai.db
# Alla filer med .db, .sqlite och .sqlite3:
*.db
*.sqlite
*.sqlite3
data/parquet/
*.parquet


# Lokalt sparade modeller och temporära filer från träning
*.pt
*.bin
*.pkl
*.safetensors
data/models/*
!data/models/README.md

# Alla env-filer, var de än ligger, utom exemplen
.env
.env.*
!.env.example

# ----------------------------------------------------
# 3. CLOUD & BUILD ARTEFACTS
# ----------------------------------------------------


# Temporära filer från molntjänster
tmp/
st_cache/

# ----------------------------------------------------
# 4. OS- OCH IDE-FILER
# ----------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
.claude/

# Loggfiler
*.log

# Utvärderingsartefakter (benchmark-körningar, confusion-matriser)
results/
results_new_model/

# ----------------------------------------------------
# 5. WEB (Next.js/Vercel site under web/)
# ----------------------------------------------------
web/node_modules/
web/.next/
# web/src/data/*.json (precomputed site data) stays tracked: Vercel's build
# has no Python runtime, so those JSON files ARE the deploy artifact.
DEV_LOG.md
research/out/

# local strategy doc, not public (names outreach targets / career strategy)
PLAN.md

# never track streamlit secrets or any local streamlit artefact
.streamlit/

# ----------------------------------------------------
# 6. SEARCH (search/)
# ----------------------------------------------------
.venv-search/
.venv-embed/
data/raw_anforanden/
data/search/
data/reports/search/*.part
# data/reports/search/*.json (results and manifests) stays tracked.
